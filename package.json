{
  "name": "yt-downloader",
  "version": "1.0.0",
  "description": "YouTube to MP4 downloader web server",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:bundle": "node scripts/bundle.js",
    "build:sea": "node --experimental-sea-config sea-config.json",
    "build:icons": "node scripts/generate-icons.js",
    "build": "npm run build:bundle && npm run build:sea"
  },
  "dependencies": {
    "archiver": "^5.3.2",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "esbuild": "^0.24.0",
    "postject": "^1.0.0-alpha.6"
  },
  "engines": {
    "node": ">=20"
  }
}
