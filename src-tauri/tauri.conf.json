{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YTDL",
  "version": "1.0.0",
  "identifier": "com.ytdl.app",
  "build": {
    "beforeBuildCommand": "node scripts/bundle.js",
    "frontendDist": "../public"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/ytdl-server",
      "binaries/yt-dlp",
      "binaries/ffmpeg"
    ],
    "resources": {
      "../public/index.html": "public/index.html"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "infoPlist": {
        "LSUIElement": true
      }
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
